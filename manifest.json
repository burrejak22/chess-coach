{
  "manifest_version": 3,
  "name": "Chess Coach",
  "version": "0.5.1",
  "description": "Study helper for Lichess & Chess.com: good human moves, why they work, the plan, and a review of each move. Off during live games.",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["https://lichess.org/*", "https://www.chess.com/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Chess Coach", "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": ["https://lichess.org/*", "https://www.chess.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["sidepanel.html", "sidepanel.css", "sidepanel.js", "openings-ui.js", "lib/*", "engine/*", "icons/*"],
      "matches": ["https://lichess.org/*", "https://www.chess.com/*"]
    }
  ]
}
